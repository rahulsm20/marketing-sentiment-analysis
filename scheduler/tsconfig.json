{
  "compilerOptions": {
    "target": "ES6",
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/*": ["../ts-packages/src/*"]
    },
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "types.ts", "../ts-packages/**/*.ts"],
  "exclude": ["node_modules"]
}
