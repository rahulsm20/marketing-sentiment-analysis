    "express": "^4.19.2",
    "mongoose": "^8.18.2",
    "postgres": "^3.4.7",
    "redis": "^4.6.14",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^20.14.2",
    "@types/ws": "^8.5.10",
