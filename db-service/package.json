  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev src/server.ts",
    "build": "tsc && npx drizzle-kit generate",
    "start": "node dist/src/server.js",
    "generate": "npx drizzle-kit generate --dialect=postgresql --schema src/lib/db/schema.ts --out ./drizzle",
    "migrate": "npx drizzle-kit migrate",
    "deploy": "npx prisma migrate deploy && npx prisma generate"
  },
