# ---------- Build stage ----------
FROM oven/bun:1.2.18 AS build
WORKDIR /usr/src/app

COPY package.json bun.lock ./

COPY ts-packages ./ts-packages
COPY scraping-service ./scraping-service

RUN mkdir scheduler chat-service cron-service \
 && echo '{"name":"scheduler","version":"1.0.0"}' > scheduler/package.json \
 && echo '{"name":"chat-service","version":"1.0.0"}' > chat-service/package.json \ 
 && echo '{"name":"cron-service","version":"1.0.0"}' > cron-service/package.json

RUN bun install

WORKDIR /usr/src/app/scraping-service
RUN bun run build

# ---------- Release stage ----------
FROM oven/bun:1.2.18 AS release
WORKDIR /usr/src/app

ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-sandbox \
    fonts-liberation \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY --from=build /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/scraping-service/dist ./scraping-service/dist
COPY --from=build /usr/src/app/ts-packages ./ts-packages

WORKDIR /usr/src/app/scraping-service

EXPOSE 8080
CMD ["bun", "dist/server.js"]